/**
 * @file    hal_usb_cdc_common.c
 * @brief   USB CDC 类驱动（芯片无关部分）
 *
 * 负责：
 *   - 提供 CDC 的接口/端点描述符
 *   - 处理 CDC 类请求（SET_LINE_CODING / GET_LINE_CODING / SET_CONTROL_LINE_STATE）
 *   - 维护收发环形缓冲
 *   - DTR 状态跟踪
 *
 * 芯片相关部分（端点收发）由 port 层的 hal_usb_xxx.c 通过
 * hal_usb_t::ep_write / ep_read 提供。
 */
#include "hal_usb_cdc.h"
#include "hal_usb.h"
#include <string.h>

/* ===========================================================================
 * 描述符常量
 * =========================================================================== */
#define CDC_DESC_LEN        35      /* 接口关联 + 2 接口 + 3 端点 */

/* 类特定描述符类型 */
#define CS_INTERFACE        0x24
#define CS_ENDPOINT         0x25

/* CDC 子类 */
#define CDC_SUBCLASS_ACM    0x02
#define CDC_PROTOCOL_V25    0x01

/* CDC 类请求 */
#define CDC_SET_LINE_CODING         0x20
#define CDC_GET_LINE_CODING         0x21
#define CDC_SET_CONTROL_LINE_STATE  0x22

/* ===========================================================================
 * 状态
 * =========================================================================== */
typedef struct {
    hal_usb_cdc_cfg_t   cfg;
    hal_usb_cdc_rx_cb_t rx_cb;
    void               *rx_user;

    uint8_t             configured;
    uint8_t             dtr;            /* 主机置位 DTR */
    uint8_t             line_coding[7]; /* 波特率(4) + 停止位 + 校验 + 数据位 */

    /* 接收环形缓冲 */
    volatile uint16_t   rx_head;
    volatile uint16_t   rx_tail;
    uint8_t            *rx_buf;

    /* 发送环形缓冲 */
    volatile uint16_t   tx_head;
    volatile uint16_t   tx_tail;
    uint8_t            *tx_buf;
} cdc_ctx_t;

static cdc_ctx_t s_cdc;

/* 默认缓冲（应用未指定时使用） */
static uint8_t s_rx_default[128];
static uint8_t s_tx_default[128];

/* ===========================================================================
 * 描述符生成
 * =========================================================================== */
static uint16_t cdc_get_config_desc(uint8_t *buf, uint16_t max_len,
                                    uint8_t first_if)
{
    uint8_t n = first_if;
    uint16_t i = 0;

    if (max_len < CDC_DESC_LEN) return 0;

    /* 接口关联描述符（IAD） */
    buf[i++] = 0x08;            /* bLength */
    buf[i++] = 0x0B;            /* bDescriptorType = INTERFACE_ASSOCIATION */
    buf[i++] = n;               /* bFirstInterface */
    buf[i++] = 0x02;            /* bInterfaceCount */
    buf[i++] = 0x02;            /* bFunctionClass = CDC */
    buf[i++] = 0x02;            /* bFunctionSubClass = ACM */
    buf[i++] = 0x01;            /* bFunctionProtocol */
    buf[i++] = 0x00;            /* iFunction */

    /* 通信接口（接口 n） */
    buf[i++] = 0x09;            /* bLength */
    buf[i++] = 0x04;            /* INTERFACE */
    buf[i++] = n;               /* bInterfaceNumber */
    buf[i++] = 0x00;            /* bAlternateSetting */
    buf[i++] = 0x01;            /* bNumEndpoints */
    buf[i++] = 0x02;            /* bInterfaceClass = CDC */
    buf[i++] = 0x02;            /* bInterfaceSubClass = ACM */
    buf[i++] = 0x01;            /* bInterfaceProtocol */
    buf[i++] = 0x00;            /* iInterface */

    /* Header 功能描述符 */
    buf[i++] = 0x05; buf[i++] = CS_INTERFACE; buf[i++] = 0x00;
    buf[i++] = 0x10; buf[i++] = 0x01;   /* bcdCDC = 1.10 */

    /* Call Management 功能描述符 */
    buf[i++] = 0x05; buf[i++] = CS_INTERFACE; buf[i++] = 0x01;
    buf[i++] = 0x00;            /* bmCapabilities */
    buf[i++] = (uint8_t)(n + 1);/* bDataInterface */

    /* ACM 功能描述符 */
    buf[i++] = 0x04; buf[i++] = CS_INTERFACE; buf[i++] = 0x02;
    buf[i++] = 0x02;            /* bmCapabilities: 支持 Set_Line_Coding */

    /* Union 功能描述符 */
    buf[i++] = 0x05; buf[i++] = CS_INTERFACE; buf[i++] = 0x06;
    buf[i++] = n;               /* bControlInterface */
    buf[i++] = (uint8_t)(n + 1);/* bSubordinateInterface0 */

    /* 通知端点（中断 IN） */
    buf[i++] = 0x07;            /* bLength */
    buf[i++] = 0x05;            /* ENDPOINT */
    buf[i++] = (uint8_t)(0x80 | s_cdc.cfg.ep_notify);
    buf[i++] = 0x03;            /* bmAttributes = Interrupt */
    buf[i++] = 0x08; buf[i++] = 0x00;   /* wMaxPacketSize = 8 */
    buf[i++] = 0x10;            /* bInterval = 16ms */

    /* 数据接口（接口 n+1） */
    buf[i++] = 0x09; buf[i++] = 0x04;
    buf[i++] = (uint8_t)(n + 1);/* bInterfaceNumber */
    buf[i++] = 0x00;            /* bAlternateSetting */
    buf[i++] = 0x02;            /* bNumEndpoints */
    buf[i++] = 0x0A;            /* bInterfaceClass = CDC Data */
    buf[i++] = 0x00; buf[i++] = 0x00; buf[i++] = 0x00;

    /* 数据 OUT 端点 */
    buf[i++] = 0x07; buf[i++] = 0x05;
    buf[i++] = s_cdc.cfg.ep_out;
    buf[i++] = 0x02;            /* Bulk */
    buf[i++] = 0x40; buf[i++] = 0x00;   /* 64 字节 */
    buf[i++] = 0x00;

    /* 数据 IN 端点 */
    buf[i++] = 0x07; buf[i++] = 0x05;
    buf[i++] = (uint8_t)(0x80 | s_cdc.cfg.ep_in);
    buf[i++] = 0x02;            /* Bulk */
    buf[i++] = 0x40; buf[i++] = 0x00;
    buf[i++] = 0x00;

    return i;
}

static uint8_t cdc_get_eps(hal_usb_ep_t *eps, uint8_t max_eps)
{
    if (max_eps < 3) return 0;

    eps[0].ep_num = s_cdc.cfg.ep_notify;
    eps[0].type = HAL_USB_EP_INT;
    eps[0].dir = HAL_USB_EP_IN;
    eps[0].max_packet = 8;
    eps[0].interval = 16;

    eps[1].ep_num = s_cdc.cfg.ep_out;
    eps[1].type = HAL_USB_EP_BULK;
    eps[1].dir = HAL_USB_EP_OUT;
    eps[1].max_packet = 64;
    eps[1].interval = 0;

    eps[2].ep_num = s_cdc.cfg.ep_in;
    eps[2].type = HAL_USB_EP_BULK;
    eps[2].dir = HAL_USB_EP_IN;
    eps[2].max_packet = 64;
    eps[2].interval = 0;

    return 3;
}

/* ===========================================================================
 * 初始化
 * =========================================================================== */
static hal_err_t cdc_init(void *ctx)
{
    s_cdc.rx_head = s_cdc.rx_tail = 0;
    s_cdc.tx_head = s_cdc.tx_tail = 0;
    s_cdc.dtr = 0;
    s_cdc.configured = 1;

    /* 默认 115200 8N1 */
    s_cdc.line_coding[0] = 0x00;
    s_cdc.line_coding[1] = 0xC2;
    s_cdc.line_coding[2] = 0x01;
    s_cdc.line_coding[3] = 0x00;
    s_cdc.line_coding[4] = 0x00;    /* 1 停止位 */
    s_cdc.line_coding[5] = 0x00;    /* 无校验 */
    s_cdc.line_coding[6] = 0x08;    /* 8 数据位 */
    return HAL_OK;
}

/* ===========================================================================
 * 类请求处理
 * =========================================================================== */
static hal_err_t cdc_on_setup(void *ctx, const uint8_t setup[8])
{
    uint8_t bmRequestType = setup[0];
    uint8_t bRequest      = setup[1];

    /* 类请求：bmRequestType bit6:5 = 01 (Class) */
    if ((bmRequestType & 0x60) != 0x20) return HAL_ERR_UNSUP;

    switch (bRequest) {
    case CDC_SET_LINE_CODING:
        /* 数据阶段由 port 层写入 s_cdc.line_coding */
        return HAL_OK;

    case CDC_GET_LINE_CODING:
        /* 数据阶段由 port 层从 s_cdc.line_coding 读出 */
        return HAL_OK;

    case CDC_SET_CONTROL_LINE_STATE:
        s_cdc.dtr = (uint8_t)(setup[2] & 0x01);
        return HAL_OK;

    default:
        return HAL_ERR_UNSUP;
    }
}

/* ===========================================================================
 * 数据收发
 * =========================================================================== */
static void cdc_on_ep_out(void *ctx, uint8_t ep, uint16_t len)
{
    /* 数据已由 port 层收进 s_cdc.rx_buf，这里触发回调 */
    if (s_cdc.rx_cb && len) {
        s_cdc.rx_cb(s_cdc.rx_buf, len, s_cdc.rx_user);
    }
}

static void cdc_on_ep_in(void *ctx, uint8_t ep, uint16_t len)
{
    /* 发送完成，可继续下一包 */
}

static void cdc_on_reset(void *ctx)
{
    s_cdc.configured = 0;
    s_cdc.dtr = 0;
    s_cdc.rx_head = s_cdc.rx_tail = 0;
    s_cdc.tx_head = s_cdc.tx_tail = 0;
}

/* ===========================================================================
 * 类驱动实例
 * =========================================================================== */
static const hal_usb_class_drv_t s_cdc_drv = {
    .type            = HAL_USB_CLASS_CDC,
    .name            = "cdc",
    .get_config_desc = cdc_get_config_desc,
    .get_eps         = cdc_get_eps,
    .init            = cdc_init,
    .on_setup        = cdc_on_setup,
    .on_ep_in        = cdc_on_ep_in,
    .on_ep_out       = cdc_on_ep_out,
    .on_reset        = cdc_on_reset,
    .on_suspend      = NULL,
    .on_resume       = NULL,
};

/* ===========================================================================
 * 对外 API
 * =========================================================================== */
hal_err_t hal_usb_cdc_add(const hal_usb_cdc_cfg_t *cfg,
                          hal_usb_cdc_rx_cb_t cb, void *user)
{
    hal_usb_t *u = hal_usb_get();

    if (!u) return HAL_ERR_NOINIT;

    /* 默认端点号 */
    s_cdc.cfg.ep_in     = (cfg && cfg->ep_in)     ? cfg->ep_in     : 3;
    s_cdc.cfg.ep_out    = (cfg && cfg->ep_out)    ? cfg->ep_out    : 2;
    s_cdc.cfg.ep_notify = (cfg && cfg->ep_notify) ? cfg->ep_notify : 1;
    s_cdc.cfg.rx_buf_size = (cfg && cfg->rx_buf_size) ? cfg->rx_buf_size : 128;
    s_cdc.cfg.tx_buf_size = (cfg && cfg->tx_buf_size) ? cfg->tx_buf_size : 128;

    s_cdc.rx_buf = (cfg && cfg->rx_buf_size > sizeof(s_rx_default))
                   ? NULL : s_rx_default;
    s_cdc.tx_buf = (cfg && cfg->tx_buf_size > sizeof(s_tx_default))
                   ? NULL : s_tx_default;

    s_cdc.rx_cb   = cb;
    s_cdc.rx_user = user;

    return u->add_class(u, &s_cdc_drv, &s_cdc);
}

int hal_usb_cdc_write(const uint8_t *data, uint16_t len)
{
    hal_usb_t *u = hal_usb_get();
    uint16_t i, next;

    if (!u || !data || !len || !s_cdc.configured) return 0;

    for (i = 0; i < len; i++) {
        next = (uint16_t)((s_cdc.tx_head + 1) % s_cdc.cfg.tx_buf_size);
        if (next == s_cdc.tx_tail) break;
        s_cdc.tx_buf[s_cdc.tx_head] = data[i];
        s_cdc.tx_head = next;
    }

    if (i) {
        u->ep_write(u, s_cdc.cfg.ep_in, s_cdc.tx_buf, i);
        s_cdc.tx_tail = s_cdc.tx_head;
    }
    return (int)i;
}

uint8_t hal_usb_cdc_connected(void)
{
    return s_cdc.dtr;
}

int hal_usb_cdc_log_write(const uint8_t *data, uint16_t len)
{
    return hal_usb_cdc_write(data, len);
}

/* 供 port 层访问内部状态 */
cdc_ctx_t *hal_usb_cdc_ctx(void)
{
    return &s_cdc;
}
